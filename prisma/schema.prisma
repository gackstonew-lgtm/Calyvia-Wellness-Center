// Calyvia Wellness Center - Comprehensive HMIS Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  FACILITY_ADMIN
  MEDICAL_DIRECTOR
  DOCTOR_PSYCHIATRIST
  NURSE
  COUNSELLOR
  PHARMACIST
  ADMISSIONS_FRONT_DESK
  FINANCE_BILLING
  INVENTORY_STORE
  MANAGEMENT_EXECUTIVE
}

enum PatientStatus {
  ENQUIRY
  TRIAGE
  ADMITTED_DETOX
  ADMITTED_REHAB
  ON_LEAVE
  DISCHARGED
  AFTERCARE
  DECEASED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AdmissionType {
  VOLUNTARY
  FAMILY_ESCORTED
  MEDICAL_TRANSFER
  COURT_ORDERED
}

enum ProgramType {
  DETOX_ONLY
  REHAB_30_DAYS
  REHAB_60_DAYS
  REHAB_90_DAYS
  OUTPATIENT
  AFTERCARE_ONLY
}

enum NoteType {
  PSYCHIATRIC_EVALUATION
  DOCTOR_CLINICAL_NOTE
  NURSING_SHIFT_NOTE
  MDT_REVIEW
  COUNSELLING_PROGRESS
}

enum DetoxProtocolType {
  ALCOHOL_CIWA
  OPIOID_COWS
  SEDATIVE_TAPER
  POLY_SUBSTANCE
}

enum ScoreType {
  CIWA_AR
  COWS
}

enum AssessmentSeverity {
  MILD
  MODERATE
  SEVERE
}

enum RoomType {
  DETOX_WARD
  INPATIENT_MALE
  INPATIENT_FEMALE
  VIP_PRIVATE
  HIGH_DEPENDENCY_UNIT
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  FULLY_PAID
  VOID
}

enum PaymentMethod {
  MPESA_STK
  MPESA_C2B
  BANK_TRANSFER
  CASH
  INSURANCE_COPAY
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
  CANCELLED
}

// ----------------------------------------------------
// 24. Security, Auth & 12. Staff Management
// ----------------------------------------------------

model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  role            UserRole
  fullName        String
  phone           String?
  isActive        Boolean       @default(true)
  twoFactorSecret String?
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  staffProfile    StaffProfile?
  auditLogs       AuditLog[]
  clinicalNotes   ClinicalNote[]
  tasksAssigned   StaffTask[]   @relation("TaskAssignee")
  tasksCreated    StaffTask[]   @relation("TaskCreator")

  @@map("users")
}

model StaffProfile {
  id                  String            @id @default(uuid())
  userId              String            @unique
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalIdEncrypted String
  department          String
  jobTitle            String
  licenseNumber       String?           // e.g. KMPDC or NCK reg number
  licenseBoard        String?           // Kenya Medical Practitioners and Dentists Council
  licenseExpiryDate   DateTime?
  dateJoined          DateTime
  qualifications      String?
  emergencyContact    String?

  schedules           StaffSchedule[]
  credentials         StaffCredential[]

  @@map("staff_profiles")
}

model StaffSchedule {
  id             String       @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  shiftDate      DateTime
  shiftType      String       // DAY, NIGHT, ON_CALL
  startTime      DateTime
  endTime        DateTime
  isAttended     Boolean      @default(false)
  notes          String?

  @@map("staff_schedules")
}

model StaffCredential {
  id             String       @id @default(uuid())
  staffProfileId String
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  title          String
  issuingBody    String
  issueDate      DateTime
  expiryDate     DateTime
  documentUrl    String?

  @@map("staff_credentials")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  role        String?
  action      String
  resource    String
  resourceId  String?
  ipAddress   String?
  userAgent   String?
  diffJson    Json?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------
// 01. Patient Management & 18. Family Management
// ----------------------------------------------------

model Patient {
  id                   String            @id @default(uuid())
  registrationNumber   String            @unique // e.g. CAL-2026-0042
  firstName            String
  lastName             String
  preferredName        String?
  nationalIdEncrypted  String?
  dateOfBirth          DateTime
  gender               Gender
  phone                String            // +254XXXXXXXXX
  email                String?
  county               String            // Kiambu, Nairobi, etc.
  residentialAddress   String
  bloodGroup           String?
  knownAllergiesEnc    String?           // Encrypted
  substanceHistoryEnc  String?           // Encrypted
  status               PatientStatus     @default(ENQUIRY)
  isArchived           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  emergencyContacts    EmergencyContact[]
  consents             PatientConsent[]
  admissions           Admission[]
  clinicalNotes        ClinicalNote[]
  detoxEpisodes        DetoxEpisode[]
  counsellingSessions  CounsellingSession[]
  prescriptions        Prescription[]
  invoices             Invoice[]
  bedAllocations       BedAllocation[]
  movementRecords      MovementRecord[]
  incidentReports      IncidentReport[]
  dischargeRecords     DischargeRecord[]
  aftercarePlans       AftercarePlan[]
  feedbackSurveys      FeedbackSurvey[]

  @@map("patients")
}

model EmergencyContact {
  id                  String   @id @default(uuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fullName            String
  relationship        String   // Parent, Spouse, Sibling, Employer
  phone               String
  email               String?
  address             String?
  isPrimaryGuarantor  Boolean  @default(false)
  hasConsentToUpdate  Boolean  @default(true)

  @@map("emergency_contacts")
}

model PatientConsent {
  id              String   @id @default(uuid())
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentType     String   // ADMISSION_AGREEMENT, DATA_PROCESSING_KDPA, MEDICAL_DETOX_CONSENT
  isGranted       Boolean  @default(true)
  signatoryName   String
  signatoryPhone  String?
  signatureData   String?  // Base64 or digital sign token
  signedAt        DateTime @default(now())

  @@map("patient_consents")
}

// ----------------------------------------------------
// 02. CRM & Admissions & 19. Referral Management
// ----------------------------------------------------

model ReferralPartner {
  id              String   @id @default(uuid())
  organizationName String
  contactPerson   String
  phone           String
  email           String?
  category        String   // HOSPITAL, PSYCHIATRIST, RECOVERY_ALUMNI, CHURCH, CORPORATE
  commissionNote  String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  leads           Lead[]

  @@map("referral_partners")
}

model Lead {
  id                String           @id @default(uuid())
  enquiryNumber     String           @unique
  fullName          String
  phone             String
  email             String?
  referralPartnerId String?
  referralPartner   ReferralPartner? @relation(fields: [referralPartnerId], references: [id], onDelete: SetNull)
  channel           String           // WEBSITE_FORM, PHONE_INQUIRY, WHATSAPP, WALK_IN
  substancesUsed    String?
  urgencyLevel      String           // ROUTINE, URGENT, CRISIS
  pipelineStatus    String           @default("NEW_INQUIRY")
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("leads")
}

model Admission {
  id                  String         @id @default(uuid())
  admissionNumber     String         @unique
  patientId           String
  patient             Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionDate       DateTime       @default(now())
  dischargeDate       DateTime?
  admissionType       AdmissionType  @default(VOLUNTARY)
  programType         ProgramType    @default(REHAB_30_DAYS)
  admittingDoctorName String
  primaryCounsellorName String
  status              String         @default("ACTIVE") // ACTIVE, COMPLETED, TRANSFERRED

  bedAllocations      BedAllocation[]
  clinicalNotes       ClinicalNote[]
  detoxEpisodes       DetoxEpisode[]
  invoices            Invoice[]

  @@map("admissions")
}

// ----------------------------------------------------
// 09. Rooms & Beds Allocation
// ----------------------------------------------------

model Room {
  id          String    @id @default(uuid())
  roomNumber  String    @unique
  wardName    String    // Ground Detox, Serenity Wing, Horizon Wing
  roomType    RoomType
  dailyRateKES Decimal  @db.Decimal(10, 2)
  isActive    Boolean   @default(true)

  beds        Bed[]

  @@map("rooms")
}

model Bed {
  id          String          @id @default(uuid())
  roomId      String
  room        Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bedNumber   String          // Bed A, Bed B
  status      BedStatus       @default(AVAILABLE)

  allocations BedAllocation[]

  @@unique([roomId, bedNumber])
  @@map("beds")
}

model BedAllocation {
  id           String     @id @default(uuid())
  bedId        String
  bed          Bed        @relation(fields: [bedId], references: [id])
  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id])
  admissionId  String
  admission    Admission  @relation(fields: [admissionId], references: [id])
  startDate    DateTime   @default(now())
  endDate      DateTime?
  transferReason String?
  isActive     Boolean    @default(true)

  @@map("bed_allocations")
}

// ----------------------------------------------------
// 03. Medical & Clinical Records (Versioned Append-Only)
// ----------------------------------------------------

model ClinicalNote {
  id                 String       @id @default(uuid())
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId        String?
  admission          Admission?   @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  authorId           String
  author             User         @relation(fields: [authorId], references: [id])
  noteType           NoteType
  version            Int          @default(1)
  parentNoteId       String?
  subjectiveEnc      String       // Encrypted
  objectiveEnc       String       // Encrypted
  assessmentEnc      String       // Encrypted
  planEnc            String       // Encrypted
  icd10Diagnosis     String?      // e.g. F10.2 (Alcohol dependence)
  isLocked           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  @@index([patientId, createdAt])
  @@map("clinical_notes")
}

// ----------------------------------------------------
// 04. Detox Management (CIWA-Ar, COWS & Vitals)
// ----------------------------------------------------

model DetoxEpisode {
  id                String                 @id @default(uuid())
  patientId         String
  patient           Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId       String?
  admission         Admission?             @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  protocolType      DetoxProtocolType
  startDate         DateTime               @default(now())
  endDate           DateTime?
  isCompleted       Boolean                @default(false)
  medicalOfficer    String
  completionNotes   String?

  assessments       WithdrawalAssessment[]
  vitalsLogs        VitalsLog[]

  @@map("detox_episodes")
}

model WithdrawalAssessment {
  id             String             @id @default(uuid())
  detoxEpisodeId String
  detoxEpisode   DetoxEpisode       @relation(fields: [detoxEpisodeId], references: [id], onDelete: Cascade)
  scoreType      ScoreType
  totalScore     Int
  severity       AssessmentSeverity
  parametersJson Json               // Detailed item responses
  evaluatedBy    String
  evaluatedAt    DateTime           @default(now())

  @@map("withdrawal_assessments")
}

model VitalsLog {
  id             String       @id @default(uuid())
  detoxEpisodeId String
  detoxEpisode   DetoxEpisode @relation(fields: [detoxEpisodeId], references: [id], onDelete: Cascade)
  systolicBP     Int
  diastolicBP    Int
  pulseRate      Int
  temperatureC   Decimal      @db.Decimal(4, 1)
  respiratoryRate Int
  spO2Percentage Int
  recordedBy     String
  recordedAt     DateTime     @default(now())

  @@map("vitals_logs")
}

// ----------------------------------------------------
// 05. Counselling & Therapy & 06. Appointments
// ----------------------------------------------------

model CounsellingSession {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  counsellorName String
  sessionType    String   // INDIVIDUAL, GROUP, FAMILY, ADOLESCENT
  scheduledAt    DateTime
  durationMins   Int      @default(60)
  goalsAddressed String?
  sessionNotesEnc String? // Encrypted
  isAttended     Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@map("counselling_sessions")
}

model Appointment {
  id             String   @id @default(uuid())
  title          String
  patientId      String?
  staffMemberName String
  appointmentType String  // PSYCHIATRIC_REVIEW, FAMILY_THERAPY, MEDICAL_CHECKUP
  startTime      DateTime
  endTime        DateTime
  location       String   // Consultation Room 1, Therapy Hall
  isReminderSent Boolean  @default(false)
  status         String   @default("SCHEDULED")

  @@map("appointments")
}

// ----------------------------------------------------
// 08. Pharmacy & Medication Administration (e-MAR)
// ----------------------------------------------------

model Medication {
  id               String       @id @default(uuid())
  brandName        String
  genericName      String
  strength         String       // e.g. 10mg, 500mg
  dosageForm       String       // Tablet, Syrup, Injection
  currentStock     Int          @default(0)
  reorderLevel     Int          @default(20)
  unitPriceKES     Decimal      @db.Decimal(10, 2)
  isControlledDrug Boolean      @default(false) // Diazepam, Methadone, etc.

  batches          PharmacyStockBatch[]
  prescriptions    PrescriptionItem[]

  @@map("medications")
}

model PharmacyStockBatch {
  id           String     @id @default(uuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  batchNumber  String
  quantity     Int
  expiryDate   DateTime
  receivedDate DateTime   @default(now())

  @@map("pharmacy_stock_batches")
}

model Prescription {
  id             String             @id @default(uuid())
  patientId      String
  patient        Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorName     String
  prescribedDate DateTime           @default(now())
  status         String             @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED

  items          PrescriptionItem[]
  administrations MedicationAdministration[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicationId   String
  medication     Medication   @relation(fields: [medicationId], references: [id])
  dosage         String       // e.g. 10mg
  frequency      String       // TID, BID, OD, PRN
  durationDays   Int
  instructions   String?

  @@map("prescription_items")
}

model MedicationAdministration {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  administeredBy String       // Nurse Name
  administeredAt DateTime     @default(now())
  status         String       // GIVEN, REFUSED, WITHHELD
  notes          String?

  @@map("medication_administrations")
}

// ----------------------------------------------------
// 07. Billing & M-Pesa Integration
// ----------------------------------------------------

model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique // INV-2026-0089
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId     String?
  admission       Admission?    @relation(fields: [admissionId], references: [id], onDelete: SetNull)
  totalAmountKES  Decimal       @db.Decimal(12, 2)
  paidAmountKES   Decimal       @default(0) @db.Decimal(12, 2)
  balanceKES      Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(ISSUED)
  dueDate         DateTime
  createdAt       DateTime      @default(now())

  items           InvoiceItem[]
  payments        Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPriceKES Decimal @db.Decimal(10, 2)
  amountKES   Decimal  @db.Decimal(10, 2)

  @@map("invoice_items")
}

model Payment {
  id               String            @id @default(uuid())
  receiptNumber    String            @unique // REC-2026-0142
  invoiceId        String
  invoice          Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountKES        Decimal           @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  transactionRef   String?           // M-Pesa Receipt Code or Bank slip
  receivedBy       String
  receivedAt       DateTime          @default(now())

  mpesaTransaction MpesaTransaction?

  @@map("payments")
}

model MpesaTransaction {
  id                String   @id @default(uuid())
  paymentId         String?  @unique
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  merchantRequestId String
  checkoutRequestId String   @unique
  phoneNumber       String
  amount            Decimal  @db.Decimal(10, 2)
  mpesaReceiptNumber String? @unique
  resultCode        Int
  resultDesc        String
  transactionDate   DateTime @default(now())
  rawCallbackJson   Json?

  @@map("mpesa_transactions")
}

// ----------------------------------------------------
// 10. Patient Movement & Visitors & 11. Incidents
// ----------------------------------------------------

model MovementRecord {
  id             String    @id @default(uuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  movementType   String    // MEDICAL_ESCORT, COURT_APPEARANCE, THERAPEUTIC_PASS
  departureTime  DateTime
  expectedReturn DateTime
  actualReturn   DateTime?
  escortPerson   String?
  status         String    @default("ON_LEAVE") // ON_LEAVE, RETURNED, OVERDUE

  @@map("movement_records")
}

model VisitorLog {
  id             String   @id @default(uuid())
  visitorName    String
  nationalId     String
  phoneNumber    String
  patientName    String
  relationship   String
  checkInTime    DateTime @default(now())
  checkOutTime   DateTime?
  belongingsChecked Boolean @default(true) // Contraband check
  officerName    String

  @@map("visitor_logs")
}

model IncidentReport {
  id             String           @id @default(uuid())
  incidentNumber String           @unique
  patientId      String?
  patient        Patient?         @relation(fields: [patientId], references: [id], onDelete: SetNull)
  severity       IncidentSeverity
  category       String           // ABSCONDING, MEDICAL_EMERGENCY, CONTRABAND, SELF_HARM_ATTEMPT
  description    String
  immediateAction String
  reportedBy     String
  reportedAt     DateTime         @default(now())
  isResolved     Boolean          @default(false)
  resolutionNotes String?

  @@map("incident_reports")
}

// ----------------------------------------------------
// 13. Tasks & 14. Inventory Management
// ----------------------------------------------------

model StaffTask {
  id          String       @id @default(uuid())
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(PENDING)
  dueDate     DateTime
  assignedToId String
  assignedTo  User         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById String
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@map("staff_tasks")
}

model InventoryItem {
  id          String   @id @default(uuid())
  itemCode    String   @unique
  name        String
  category    String   // FOOD_KITCHEN, CLEANING, MEDICAL_SUPPLIES, LINEN
  quantity    Int      @default(0)
  unit        String   // kg, boxes, litres
  minAlertQty Int      @default(10)
  unitCostKES Decimal  @db.Decimal(10, 2)
  supplier    String?

  @@map("inventory_items")
}

// ----------------------------------------------------
// 16. Discharge & 17. Aftercare & Recovery
// ----------------------------------------------------

model DischargeRecord {
  id                 String   @id @default(uuid())
  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dischargeDate      DateTime @default(now())
  medicalSummary     String
  dischargeMedsEnc   String?  // Encrypted take-home prescriptions
  familyBriefingNotes String?
  clinicalClearance  Boolean  @default(true)
  financialClearance Boolean  @default(true)
  signedByDoctor     String

  aftercarePlan      AftercarePlan?

  @@map("discharge_records")
}

model AftercarePlan {
  id                String            @id @default(uuid())
  patientId         String
  patient           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  dischargeRecordId String?           @unique
  dischargeRecord   DischargeRecord?  @relation(fields: [dischargeRecordId], references: [id], onDelete: SetNull)
  planStartDate     DateTime
  counsellorInCharge String
  relapseRiskLevel  String            // LOW, MEDIUM, HIGH
  supportGroupDetails String?

  checkins          AftercareCheckin[]

  @@map("aftercare_plans")
}

model AftercareCheckin {
  id              String        @id @default(uuid())
  aftercarePlanId String
  aftercarePlan   AftercarePlan @relation(fields: [aftercarePlanId], references: [id], onDelete: Cascade)
  cadenceDay      Int           // 7, 14, 30, 60, 90
  contactMethod   String        // PHONE_CALL, WHATSAPP, IN_PERSON
  sobrietyStatus  String        // SOBER, RELAPSED, STRUGGLING
  notes           String
  conductedAt     DateTime      @default(now())

  @@map("aftercare_checkins")
}

// ----------------------------------------------------
// 20. Communication & 21. Feedback & 25. System Admin
// ----------------------------------------------------

model CommunicationLog {
  id          String   @id @default(uuid())
  recipient   String   // Phone or Email
  channel     String   // SMS, WHATSAPP, EMAIL
  subject     String?
  body        String
  status      String   // DELIVERED, SENT, FAILED
  providerRef String?
  sentAt      DateTime @default(now())

  @@map("communication_logs")
}

model FeedbackSurvey {
  id                String   @id @default(uuid())
  patientId         String?
  patient           Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  rating            Int      // 1-5 stars
  cleanlinessScore  Int?
  counsellingScore  Int?
  foodQualityScore  Int?
  nursingScore      Int?
  comments          String?
  submittedAt       DateTime @default(now())

  @@map("feedback_surveys")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   // FACILITY_INFO, TARIFFS, NOTIFICATIONS
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
