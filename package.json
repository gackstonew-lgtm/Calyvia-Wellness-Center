{
  "name": "calyvia-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Calyvia Wellness Center Management System (HMIS/EMR)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,ADMIN\" -c \"green,blue\" \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "npm run dev --workspace=@calyvia/api",
    "dev:admin": "npm run dev --workspace=@calyvia/admin",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "keywords": [
    "calyvia",
    "healthcare",
    "hmis",
    "emr",
    "addiction-treatment",
    "rehabilitation"
  ],
  "author": "Calyvia Wellness Center",
  "license": "UNLICENSED",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
