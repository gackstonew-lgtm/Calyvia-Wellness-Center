{
  "name": "calyvia-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Calyvia Wellness Center Management System (HMIS/EMR)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:admin": "npm run dev --workspace=apps/admin"
  },
  "keywords": [
    "calyvia",
    "healthcare",
    "hmis",
    "emr",
    "addiction-treatment",
    "rehabilitation"
  ],
  "author": "Calyvia Wellness Center",
  "license": "UNLICENSED"
}
