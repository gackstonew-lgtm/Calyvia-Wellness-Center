# ========================================================
# CALYVIA WELLNESS CENTER MANAGEMENT SYSTEM CONFIGURATION
# Production & Local Development Environment Variables Template
# ========================================================

# General Environment & Ports
NODE_ENV=development
PORT=4000
ADMIN_PORT=3000
APP_NAME="Calyvia Wellness Center Management System"
API_URL=http://localhost:4000/api/v1
ADMIN_URL=http://localhost:3000

# Kenya Locale & Timezone
TZ=Africa/Nairobi
DEFAULT_CURRENCY=KES
COUNTRY_CODE=+254

# Supabase Project Configuration (Sole Hosted Backend)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_REST_URL=https://[PROJECT-REF].supabase.co/rest/v1/
SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_secret_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# Supabase PostgreSQL Database (Transaction Pooler: 6543, Direct: 5432)
# Password must be URL-encoded (e.g. '@' -> '%40')
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[URL_ENCODED_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[URL_ENCODED_PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_PASSWORD="[YOUR-DATABASE-PASSWORD]"

# Redis Cache & BullMQ (Optional background queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters"
JWT_REFRESH_EXPIRES_IN="7d"

# Field-Level Encryption Master Key (AES-256-GCM - exactly 32 bytes hex = 64 hex characters)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Safaricom M-Pesa Daraja Configuration (Sandbox / Production)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="sandbox_consumer_key"
MPESA_CONSUMER_SECRET="sandbox_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://api.calyviawellness.co.ke/api/v1/integrations/mpesa/callback"

# Communication Gateways (SMS & WhatsApp)
SMS_PROVIDER=mock # Options: mock, africas_talking
AFRICASTALKING_USERNAME="calyvia"
AFRICASTALKING_API_KEY="mock_at_api_key"
AFRICASTALKING_SENDER_ID="CALYVIA"

WHATSAPP_PROVIDER=mock # Options: mock, cloud_api
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_FIELD_ENCRYPTION=true
ENABLE_AI_EXTENSIONS=false
