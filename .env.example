# ========================================================
# CALYVIA WELLNESS CENTER MANAGEMENT SYSTEM CONFIGURATION
# ========================================================

# General Environment & Ports
NODE_ENV=development
PORT=4000
ADMIN_PORT=3000
APP_NAME="Calyvia Wellness Center Management System"
API_URL=http://localhost:4000/api/v1
ADMIN_URL=http://localhost:3000

# Kenya Locale & Timezone
TZ=Africa/Nairobi
DEFAULT_CURRENCY=KES
COUNTRY_CODE=+254

# Database (PostgreSQL - Local or Hosted Supabase)
# Local PostgreSQL:
DATABASE_URL="postgresql://calyvia_user:calyvia_secure_pass@localhost:5432/calyvia_db?schema=public"

# Hosted Supabase PostgreSQL Configuration:
# Transaction pooler (Supavisor Port 6543) for runtime queries:
# DATABASE_URL="postgres://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Direct connection (Port 5432) for Prisma migrations & DDL:
# DIRECT_URL="postgres://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase API & Client Secrets (from Supabase Project Settings -> API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters"

# Redis Cache & BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="calyvia_jwt_access_super_secret_development_key_2026_xyz"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="calyvia_jwt_refresh_super_secret_development_key_2026_xyz"
JWT_REFRESH_EXPIRES_IN="7d"

# Field-Level Encryption Master Key (AES-256-GCM - exactly 32 bytes hex or 32 chars)
# NEVER commit production key! For local dev: 64 hex characters (32 bytes)
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Safaricom M-Pesa Daraja Configuration (Sandbox / Production)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY="sandbox_consumer_key"
MPESA_CONSUMER_SECRET="sandbox_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://api.calyviawellness.co.ke/api/v1/integrations/mpesa/callback"

# Communication Gateways (SMS & WhatsApp)
SMS_PROVIDER=mock # Options: mock, africas_talking
AFRICASTALKING_USERNAME="calyvia"
AFRICASTALKING_API_KEY="mock_at_api_key"
AFRICASTALKING_SENDER_ID="CALYVIA"

WHATSAPP_PROVIDER=mock # Options: mock, cloud_api
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# S3 / MinIO Object Storage (Clinical documents & signatures)
STORAGE_PROVIDER=local # Options: local, s3
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="calyvia-records"

# Feature Flags
ENABLE_AUDIT_LOGGING=true
ENABLE_FIELD_ENCRYPTION=true
ENABLE_AI_EXTENSIONS=false
